.claude-memory.md
.claude/hooks/logs/
node_modules/
package-lock.json
.understand-anything/

# Environment files (never commit secrets)
.env
.env.local
.env.production

# Python
__pycache__/
*.pyc
venv/
.venv/

# MCP memory backend runtime artifacts (HNSW index + sql.js DB)
# Generated locally when calling mcp__claude-flow__memory_store — should not
# be committed. Memory data lives in mcp__claude-flow__memory namespace,
# canonical decision trail lives in docs/PROJECT_JOURNAL.md.
.swarm/

# claude-flow runtime side-effects: auto-memory-hook.mjs keeps appending
# garbage (file:"unknown", sessionId:null) to pending-insights.jsonl every
# session due to a broken stdin parser. We untracked the file (see parent
# commit); this ignore keeps it from coming back.
**/.claude-flow/data/

# graphifyy tool side-effect: creates graphify-out/cache/ in CWD when
# `graphify query` or `graphify benchmark` is run from the repo root.
# Our sandbox output lives in scripts/graphify-sandbox/out/, NOT here.
graphify-out/

# Background-agent transient git worktrees. Created by `Agent` tool with
# isolation: "worktree" — each spawned subagent gets its own checkout under
# .claude/worktrees/agent-<id>/. These are ephemeral; the agent commits to
# its own branch and the worktree is reaped automatically afterward. Should
# never appear in the parent worktree as untracked.
.claude/worktrees/

# Local scratch / working files — never committed. Used for ad-hoc data
# processing (CSV cleanup, FB ads audience exports, etc.) where the
# output contains PII (customer emails, phone numbers) that must not
# enter git history. Keep work here; git ignores the whole tree.
scratch/
